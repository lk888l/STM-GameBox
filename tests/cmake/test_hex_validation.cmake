cmake_minimum_required(VERSION 3.22)
include("${CMAKE_CURRENT_LIST_DIR}/../../cmake/ValidateFirmware.cmake")
file(MAKE_DIRECTORY "${SCRATCH}")
file(WRITE "${SCRATCH}/test.bin" "ABCD")
set(records ":020000040800F2\n:0400000041424344F2\n:0400000508000009E6\n:00000001FF\n")
if(CASE STREQUAL "checksum")
    string(REPLACE "44F2" "44F1" records "${records}")
elseif(CASE STREQUAL "address")
    string(REPLACE "0800F2" "0801F1" records "${records}")
elseif(CASE STREQUAL "eof")
    string(REPLACE ":00000001FF\n" "" records "${records}")
elseif(CASE STREQUAL "after_eof")
    string(APPEND records ":00000001FF\n")
elseif(CASE STREQUAL "entry")
    string(REPLACE "0009E6" "000BE4" records "${records}")
elseif(CASE STREQUAL "data")
    # Keep a valid HEX checksum so this specifically reaches the data audit.
    set(records ":020000040800F2\n:0400000041424345F1\n:00000001FF\n")
elseif(NOT CASE STREQUAL "valid")
    message(FATAL_ERROR "Unknown test case: ${CASE}")
endif()
file(WRITE "${SCRATCH}/test.hex" "${records}")
firmware_validate_hex("${SCRATCH}/test.hex" "${SCRATCH}/test.bin" 0x08000009)
